# Copie para .env e peça os valores a quem cuida do projeto.
# NUNCA comite o .env — o .gitignore já cobre .env*, mas confira antes de commitar.
# Os valores reais vivem nas variáveis de ambiente do projeto na Vercel.

# Private app do HubSpot com escopo de contatos, negócios e notas
HUBSPOT_TOKEN=

# Redis (guarda briefing e resultado por 90 dias)
REDIS_URL=

# Preço em centavos. 19700 = R$ 197, creditável no cachê.
PRECO_CENTAVOS=19700

# Vazio = curadoria entregue sem pagamento.
# Preencher reativa o paywall sem mexer em código.
CHECKOUT_URL=

# Token exigido no /api/webhook de confirmação de pagamento
WEBHOOK_SECRET=

# Propriedade de negócio onde a automação grava os 5 nomes
PROP_CURADORIA_NOMES=ia_curadoria_nomes

# Quantas vezes o cliente pode refazer a curadoria
MAX_REFACOES=1

# Domínios extra liberados no CORS, separados por vírgula
ORIGENS_EXTRA=
