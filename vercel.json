{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/auto-curadoria-briefing", "destination": "/ferramenta" },
    { "source": "/auto-curadoria", "destination": "/" },
    { "source": "/auto-curadoria-essencial", "destination": "/essencial" }
  ],
  "functions": {
    "api/curar.js": { "maxDuration": 60 },
    "api/resultado.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 30 },
    "api/conta.js": { "maxDuration": 120 },
    "api/palestrantes.js": { "maxDuration": 60 },
    "api/depoimentos.js": { "maxDuration": 60 }
  }
}
